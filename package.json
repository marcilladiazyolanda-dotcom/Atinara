{
  "name": "oraklo-prototype-2.0",
  "version": "12.0.0",
  "private": true,
  "description": "MVP estático de Atinara y sus comprobaciones automatizadas de calidad.",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:syntax": "node scripts/check-javascript-syntax.mjs",
    "test:monitoring-config": "tsc --project tsconfig.json",
    "validate": "npm run test:syntax && npm run test:unit && npm run test:monitoring-config",
    "checkly:test": "checkly test",
    "checkly:deploy": "checkly deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "checkly": "8.18.0"
  },
  "overrides": {
    "filelist": "2.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
